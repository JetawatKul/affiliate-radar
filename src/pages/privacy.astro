---
import BaseLayout from '../layouts/BaseLayout.astro';
import { siteConfig } from '../config/site';
---

<BaseLayout title="นโยบายความเป็นส่วนตัว" description={`นโยบายความเป็นส่วนตัวของ ${siteConfig.name}`}>
  <h1>นโยบายความเป็นส่วนตัว</h1>

  <p>ปรับปรุงล่าสุด: <em>รอ Jay ระบุวันที่เผยแพร่จริง</em></p>

  <h2>ข้อมูลที่เราเก็บ</h2>
  <p>
    เว็บนี้ใช้ Google Analytics 4 (GA4) เพื่อวัดผลการใช้งานเว็บ และอาจแสดงโฆษณาผ่าน Google AdSense
    ทั้งสองระบบอาจใช้คุกกี้เพื่อเก็บข้อมูลการใช้งานแบบไม่ระบุตัวตน เราจะขอความยินยอมจากคุณก่อนตั้งคุกกี้ที่ไม่จำเป็นเสมอ
  </p>

  <h2>เครื่องคำนวณค่าคอมมิชชัน</h2>
  <p>เครื่องคำนวณบนเว็บนี้ทำงานในเบราว์เซอร์ของคุณทั้งหมด เราไม่เก็บหรือส่งตัวเลขที่คุณกรอกไปที่เซิร์ฟเวอร์ใด</p>

  <h2>ลิงก์ Affiliate</h2>
  <p>
    บางลิงก์ในเว็บนี้เป็นลิงก์ Affiliate ซึ่งเราอาจได้รับค่าคอมมิชชันเมื่อคุณคลิกและสั่งซื้อ
    ดูรายละเอียดที่ <a href="/affiliate-disclosure">หน้าการเปิดเผยลิงก์ Affiliate</a>
  </p>

  <h2>สิทธิ์ของคุณตาม PDPA</h2>
  <p><em>รอ Jay หรือที่ปรึกษากฎหมายตรวจสอบและเติมรายละเอียดสิทธิ์ตาม พ.ร.บ. คุ้มครองข้อมูลส่วนบุคคลก่อนเปิดเว็บจริง</em></p>
</BaseLayout>
