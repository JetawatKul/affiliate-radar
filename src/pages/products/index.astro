---
import BaseLayout from '../../layouts/BaseLayout.astro';
import AffiliateLink from '../../components/AffiliateLink.astro';
import productsData from '../../data/products.json';

interface Product {
  id: string;
  name: string;
  reviewedDate: string; // YYYY-MM-DD วันที่เจตรวจสอบว่าสินค้ายังขายอยู่
  affiliateUrl: string;
  note: string;
  imageUrl?: string; // รูปสินค้า (ถ่ายเองหรือภาพหน้าจอจากร้าน) — ไม่บังคับ
  price?: number; // ราคาล่าสุดตอนตรวจ (บาท) — ไม่บังคับ เพราะราคาเปลี่ยนบ่อย
}

const products = productsData as Product[];
---

<BaseLayout
  title="สินค้าคัดมือ"
  description="รวมสินค้าที่เจลองใช้และคัดมาเอง พร้อมวันที่ตรวจสอบล่าสุดและข้อความเปิดเผยลิงก์ Affiliate"
>
  <h1>สินค้าคัดมือ</h1>
  <p>ทุกรายการเจทดลองใช้เองก่อนแนะนำ ไม่ใช่รายการที่สุ่มมาจากระบบ</p>

  {
    products.length === 0 && (
      <p>ยังไม่มีสินค้าที่คัดไว้ในขณะนี้ (รอ Jay เพิ่มข้อมูลใน src/data/products.json ตาม ticket S3)</p>
    )
  }

  <ul class="product-list">
    {
      products.map((product) => (
        <li class="product-card">
          {product.imageUrl && (
            <img src={product.imageUrl} alt={product.name} loading="lazy" width="320" height="320" />
          )}
          <div class="product-card-body">
            <h2>{product.name}</h2>
            {product.price != null && <p class="price">ราคาที่ตรวจล่าสุด: {product.price.toLocaleString('th-TH')} บาท</p>}
            <p>{product.note}</p>
            <p class="reviewed-date">ตรวจสอบล่าสุด: {product.reviewedDate}</p>
            <AffiliateLink href={product.affiliateUrl} label={product.id}>
              ดูสินค้า
            </AffiliateLink>
          </div>
        </li>
      ))
    }
  </ul>
</BaseLayout>

<style>
  .product-list {
    list-style: none;
    padding: 0;
    display: grid;
    gap: 1rem;
  }
  .product-card {
    display: flex;
    gap: 1rem;
    border: 1px solid #eee;
    border-radius: 8px;
    padding: 1.25rem;
  }
  .product-card img {
    width: 96px;
    height: 96px;
    object-fit: cover;
    border-radius: 6px;
    flex-shrink: 0;
  }
  .product-card-body {
    min-width: 0;
  }
  .product-card h2 {
    margin: 0 0 0.35rem;
    font-size: 1.05rem;
  }
  .price {
    font-weight: 700;
    margin: 0 0 0.35rem;
  }
  .reviewed-date {
    font-size: 0.8rem;
    color: #777;
  }
</style>
